# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ---------------------------------------------------------------------------
# Resend (transactional email + statutory PDF reports)
# Get key at: https://resend.com/api-keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@comet.coal.gov.in

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM) — standard push + Notifee critical alarms
# ---------------------------------------------------------------------------
FCM_PROJECT_ID=your-firebase-project-id
# Full JSON content of your Firebase service account (for HTTP v1 OAuth2 auth)
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# ---------------------------------------------------------------------------
# Redis (Celery broker + result backend + dashboard cache)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Google Gemini (AI Report Generation & Anomaly Detection)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FAST_MODEL=gemini-3.6-flash
GEMINI_INCIDENT_MODEL=gemini-3.6-flash
