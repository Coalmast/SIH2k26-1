# ==============================================================================
#  .env.docker.example — Docker environment variables
#
#  Copy this file to `.env.docker` and fill in the real values.
#  This file is loaded by docker-compose via:
#    docker compose --env-file .env.docker up --build
#
#  ⚠️  NEVER commit `.env.docker` to git — it is already in .gitignore.
# ==============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Run `supabase start` first, then paste the values shown in the output.
# On Windows/Mac, Docker containers reach the host via host.docker.internal.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# The JWT secret used by Supabase GoTrue (shown in `supabase status`)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ── Resend (transactional email) ───────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@comet.coal.gov.in

# ── Redis (managed by docker-compose, no change needed) ───────────────────────
REDIS_URL=redis://redis:6379/0

# ── Web Portal build args (baked into the Vite static bundle) ─────────────────
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_BASE_URL=http://localhost:8000
